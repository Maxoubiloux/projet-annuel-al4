{$APP_DOMAIN} {
	encode zstd gzip

	route /api/* {
		reverse_proxy backend:3000
	}

	route {
		reverse_proxy frontend:3000
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:80
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:3000
}

{$AUTH_DOMAIN} {
	encode zstd gzip
	reverse_proxy keycloak:8080
}
