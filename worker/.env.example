# Files RabbitMQ — doivent rester alignées avec le backend (ADR 0005) :
# toute divergence de nom ou de topologie provoque un PRECONDITION_FAILED.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REQUEST_QUEUE=worker_requests
RESPONSE_QUEUE=worker_responses
DEAD_LETTER_QUEUE=worker_dead_letters
DEAD_LETTER_EXCHANGE=worker_dlx

# Répertoire d'écriture des contrats PDF. En conteneur, c'est un volume partagé
# avec le backend, monté chez lui sur uploads/contracts/.
CONTRACTS_DIR=./contracts

# Racine publique de l'API : sert à composer l'URL renvoyée au backend,
# <PUBLIC_BASE_URL>/uploads/contracts/<reservation_id>.pdf
PUBLIC_BASE_URL=http://localhost:3000

# Politique de retry du job de génération de contrat.
MAX_RETRIES=3
RETRY_BACKOFF_MS=1000

# Logs : RUST_LOG a la priorité sur LOG_LEVEL (syntaxe EnvFilter).
RUST_LOG=info
LOG_LEVEL=info
RUST_BACKTRACE=1
